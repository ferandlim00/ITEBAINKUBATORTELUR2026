# Konfigurasi Server Go Fiber
APP_PORT=3000
APP_ENV=development
COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:5173

# Konfigurasi Database MySQL 8.4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_hatchery

# Kunci Master Enkripsi AES-256-GCM untuk Kredensial Wi-Fi (64 karakter hex = 32 byte)
# Di produksi, ganti dengan nilai acak aman (misal: openssl rand -hex 32)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Autentikasi Perangkat ESP32 (harus sama dengan DEVICE_API_KEY di sketch_nov6a.ino)
DEVICE_ID=inkubator-01
DEVICE_API_KEY=secret-device-token-esp32

# Akun Operator Awal (hanya dipakai saat tabel users masih kosong)
OPERATOR_USERNAME=operator1
OPERATOR_PASSWORD=operator12345

# Opsional: Notifikasi Telegram Bot untuk peringatan severity = high
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
