# Konfigurasi Docker Compose (Lokal & VPS Production)
# PENTING UNTUK LAUNCHING DI VPS:
# 1. Ganti seluruh password, APP_ENCRYPTION_KEY, dan DEVICE_API_KEY dengan nilai acak yang kuat.
# 2. Jika VPS sudah memakai HTTPS (domain + SSL), set COOKIE_SECURE=true dan isi CORS_ALLOW_ORIGINS=https://domain-anda.com.
# 3. Jika di depan container ini ada Nginx/Caddy host pada port 80/443, set FRONTEND_PORT_BIND=127.0.0.1:8080:80.

# Mode Aplikasi & Keamanan Web
APP_ENV=production
FRONTEND_PORT_BIND=80:80
COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
STALE_SECONDS=15

# Database MySQL 8.4
MYSQL_ROOT_PASSWORD=rootsecure123
DB_USER=hatchery_user
DB_PASSWORD=hatchery_secure_pass
DB_NAME=smart_hatchery

# Kunci Master AES-256-GCM (64 karakter hex = 32 byte, buat acak di VPS: openssl rand -hex 32)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Autentikasi Perangkat ESP32 (harus identik dengan sketch_nov6a.ino)
DEVICE_ID=inkubator-01
DEVICE_API_KEY=secret-device-token-esp32

# Akun Operator Awal (hanya di-seed saat tabel users masih kosong)
OPERATOR_USERNAME=operator1
OPERATOR_PASSWORD=operator12345

# Topik Push Notification Firebase Cloud Messaging (FCM)
FCM_TOPIC=incubator_alerts
